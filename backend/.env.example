# Supabase PostgreSQL Connection String
# Récupérez votre URI dans le Dashboard Supabase :
# Project Settings > Database > Connection string > URI (Port 5432 ou 6543)
# Exemple direct :
# DATABASE_URL=postgresql://postgres:[VOTRE-MOT-DE-PASSE]@db.[VOTRE-PROJECT-REF].supabase.co:5432/postgres
# Ou via Pooler (recommandé) :
# DATABASE_URL=postgresql://postgres.[VOTRE-PROJECT-REF]:[VOTRE-MOT-DE-PASSE]@aws-0-[VOTRE-REGION].pooler.supabase.com:6543/postgres

DATABASE_URL=
